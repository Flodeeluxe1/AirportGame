.root {
    width: 100%;
    height: 100%;
}

.build-window {
    position: absolute;

    left: 20px;
    top: 20px;

    width: 600px;
    height: 650px;

    flex-direction: row;

    background-color: rgba(25, 27, 32, 0.96);

    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;

    padding: 12px;
}

.category-panel {
    width: 155px;

    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 5px;
    padding-right: 10px;
}

.panel-title {
    font-size: 24px;

    margin-bottom: 15px;
    margin-left: 5px;

    -unity-font-style: bold;
}

.category-button {
    height: 42px;

    margin-bottom: 5px;

    background-color: rgb(45, 48, 55);

    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;

    font-size: 15px;

    -unity-text-align: middle-left;
}

.category-button:hover {
    background-color: rgb(65, 69, 78);
}

.category-selected {
    background-color: rgb(75, 110, 150);

    -unity-font-style: bold;
}


.bottom-bar {
    position: absolute;

    bottom: 25px;
    left: 0;
    right: 0;

    flex-direction: row;

    justify-content: center;
    align-items: center;
}

.main-button {
    width: 180px;
    height: 60px;

    margin-left: 8px;
    margin-right: 8px;

    background-color: rgb(45, 48, 55);

    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;

    font-size: 20px;
    -unity-text-align: middle-center;
}

.main-button:hover {
    background-color: rgb(65, 69, 78);
}

.buildable-card {
    width: 75px;
    height: 85px;

    margin-bottom: 5px;
    margin-right: 5px;

    padding: 4px;

    align-items: center;

    background-color: rgb(200, 200, 200);

    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.buildable-card:hover {
    background-color: rgb(65, 69, 78);
}

.buildable-icon {
    width: 50px;
    height: 50px;

    margin-bottom: 2px;

    background-color: rgb(30, 32, 37);

    background-size: 100% 100%;
    background-position: center;
    background-repeat: no-repeat;
}

.buildable-name {
    font-size: 9px;

    margin-top: 1px;
    margin-bottom: 1px;

    -unity-text-align: middle-center;
}

.buildable-cost {
    font-size: 8px;

    -unity-text-align: middle-center;
}

.buildable-list {
    flex-grow: 1;

    padding-left: 10px;
    padding-right: 10px;

    flex-direction: row;
    flex-wrap: wrap;

    align-content: flex-start;
    align-items: flex-start;
}

.buildable-selected {
    border-width: 2px;
}

.game-time-panel {
    position: absolute;
    top: 16px;
    right: 16px;
    padding: 10px;
    background-color: rgba(20, 24, 30, 0.92);
    border-radius: 8px;
    flex-direction: column;
    align-items: center;
}

.game-time-label {
    font-size: 26px;
    -unity-font-style: bold;
    color: white;
    margin-bottom: 8px;
}

.game-time-controls {
    flex-direction: row;
    align-items: center;
}

.time-speed-button {
    min-width: 48px;
    margin-left: 2px;
    margin-right: 2px;
}

.time-speed-selected {
    background-color: rgb(55, 115, 78);
    color: white;
}