
/* =========================================================
   ROOT
   ========================================================= */

.root {
    width: 100%;
    height: 100%;
}


/* =========================================================
   BUILD WINDOW
   ========================================================= */

.build-window {
    position: absolute;

    left: 20px;
    top: 20px;

    width: 600px;
    height: 650px;

    flex-direction: row;

    background-color: rgba(25, 27, 32, 0.96);

    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;

    padding: 12px;
}


/* =========================================================
   CATEGORY PANEL
   ========================================================= */

.category-panel {
    width: 185px;
    flex-shrink: 0;

    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 5px;
    padding-right: 10px;
}

.category-list {
    flex-grow: 1;
    min-height: 0;
}

.floor-subcategory-list {
    display: none;
    height: 76px;
    max-height: 76px;
    margin-left: 8px;
    margin-bottom: 6px;
    background-color: rgba(15, 17, 21, 0.35);
}

.airport-subcategory-list {
    height: 210px;
    max-height: 210px;
    margin-left: 8px;
    margin-bottom: 6px;
    background-color: rgba(15, 17, 21, 0.35);
}

.airport-subcategory-button {
    min-height: 32px;
    flex-shrink: 0;
    margin-bottom: 3px;
    padding-left: 8px;
    padding-right: 4px;
    background-color: rgb(37, 40, 46);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    font-size: 11px;
    color: white;
    -unity-text-align: middle-left;
}

.panel-title {
    font-size: 24px;

    margin-bottom: 15px;
    margin-left: 5px;

    -unity-font-style: bold;
    color: white;
}

.category-button {
    height: 42px;
    flex-shrink: 0;

    margin-bottom: 5px;

    background-color: rgb(45, 48, 55);

    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;

    font-size: 15px;
    color: white;

    -unity-text-align: middle-left;
}

.category-button:hover {
    background-color: rgb(65, 69, 78);
}

.category-selected {
    background-color: rgb(75, 110, 150);
    -unity-font-style: bold;
}


/* =========================================================
   BUILDABLE LIST
   ========================================================= */

.buildable-list {
    flex-grow: 1;
    flex-shrink: 1;

    min-width: 0;

    padding-left: 10px;
    padding-right: 10px;

    flex-direction: row;
    flex-wrap: wrap;

    align-content: flex-start;
    align-items: flex-start;

    background-color: rgba(135, 206, 235, 0.12);

    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;

    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;

    border-left-color: rgb(55, 103, 255);
    border-right-color: rgb(55, 103, 255);
    border-top-color: rgb(55, 103, 255);
    border-bottom-color: rgb(55, 103, 255);
}

.buildable-card {
    width: 86.5px;
    height: 93.5px;

    margin-bottom: 5px;
    margin-right: 5px;

    padding: 4px;

    align-items: center;

    background-color: rgb(200, 200, 200);

    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.buildable-card:hover {
    background-color: rgb(65, 69, 78);
}

.buildable-icon {
    width: 77px;
    height: 94px;

    margin-bottom: 3px;

    background-color: rgb(30, 32, 37);

    background-size: 100% 100%;
    background-position: center;
    background-repeat: no-repeat;
}

.buildable-name {
    font-size: 9px;

    margin-top: 3px;
    margin-bottom: 1px;

    -unity-text-align: middle-center;
}

.buildable-cost {
    font-size: 8.8px;
    -unity-text-align: middle-center;
}

.buildable-selected {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;

    border-top-color: rgb(50, 130, 255);
    border-right-color: rgb(50, 130, 255);
    border-bottom-color: rgb(50, 130, 255);
    border-left-color: rgb(50, 130, 255);
}


/* =========================================================
   BOTTOM ACTION BAR
   ========================================================= */

.bottom-bar {
    position: absolute;

    bottom: 25px;
    left: 0;
    width: 33%;
    right: auto;

    flex-direction: row;

    justify-content: flex-start;
    align-items: center;

    padding-left: 8px;
    padding-right: 8px;
}

.main-button {
    flex-grow: 1;
    flex-shrink: 1;

    min-width: 0;
    height: 60px;

    margin-left: 5px;
    margin-right: 5px;

    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;

    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;

    color: white;
}


/* BUILD */

.build-action-button {
    background-color: rgb(50, 130, 255);
}

.build-action-button:hover {
    background-color: rgb(75, 150, 255);
}


/* ZONES */

.zone-action-button {
    background-color: rgb(45, 48, 55);
}

.zone-action-button:hover {
    background-color: rgb(65, 69, 78);
}


/* DELETE ALL */

.delete-all-button {
    background-color: rgb(180, 45, 45);

    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;

    border-top-color: rgb(220, 90, 90);
    border-right-color: rgb(220, 90, 90);
    border-bottom-color: rgb(220, 90, 90);
    border-left-color: rgb(220, 90, 90);
}

.delete-all-button:hover {
    background-color: rgb(220, 55, 55);
}

.delete-all-button:active {
    background-color: rgb(145, 30, 30);
}


/* =========================================================
   GAME TIME PANEL
   ========================================================= */

.game-time-panel {
    position: absolute;

    top: 16px;
    right: 16px;

    padding: 10px;

    background-color: rgba(20, 24, 30, 0.92);

    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;

    flex-direction: column;
    align-items: center;
}

.game-time-label {
    font-size: 26px;

    -unity-font-style: bold;
    color: white;

    margin-bottom: 8px;
}

.game-time-controls {
    flex-direction: row;
    align-items: center;
}

.time-speed-button {
    min-width: 48px;

    margin-left: 2px;
    margin-right: 2px;
}

.time-speed-selected {
    background-color: rgb(55, 115, 78);
    color: white;
}


/* =========================================================
   BUILD MENU SEARCH
   ========================================================= */

.build-search-field {
    margin-left: 5px;
    margin-right: 5px;
    margin-bottom: 10px;
    flex-shrink: 0;
}


.build-search-field {
    color: white;
}

.build-search-field .unity-base-text-field__input,
.build-search-field .unity-text-field__input {
    background-color: rgb(235, 238, 242);
    color: rgb(25, 27, 32);
}


.build-search-label {
    margin-left: 5px;
    margin-bottom: 4px;
    color: white;
    font-size: 11px;
    -unity-font-style: bold;
    flex-shrink: 0;
}

.build-search-field {
    width: 100%;
    min-height: 32px;
    height: 32px;
    margin-left: 5px;
    margin-right: 5px;
    margin-bottom: 10px;
    flex-shrink: 0;
}

.build-search-field .unity-base-text-field__input,
.build-search-field .unity-text-field__input {
    width: 100%;
    min-width: 0;
    background-color: rgb(235, 238, 242);
    color: rgb(25, 27, 32);
}


/* FLOOR FINISH PALETTE */

.floor-finish-card {
    height: 88px;
    justify-content: center;
}

.floor-finish-icon {
    width: 72px;
    height: 54px;
    margin-bottom: 3px;
}

.floor-finish-name {
    font-size: 9px;
    white-space: normal;
    -unity-text-align: middle-center;
}
