
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
  <Style src="project://database/Assets/AirportGame/UI/AirportUI.uss?fileID=7433441132597879392&amp;guid=12497c851803d844cb55a5b69a5c3ccd&amp;type=3#AirportUI"/>

  <ui:VisualElement name="root" picking-mode="Ignore" class="root">

    <!-- BUILD WINDOW -->
    <ui:VisualElement name="build-window" picking-mode="Position" class="build-window">

      <ui:VisualElement name="category-panel" class="category-panel">
        <ui:Label text="BUILD" class="panel-title"/>

        <ui:Button name="category-floor" text="Floor" class="category-button"/>
        <ui:Button name="category-wall" text="Wall" class="category-button"/>
        <ui:Button name="category-door" text="Door" class="category-button"/>
        <ui:Button name="category-airport" text="Airport" class="category-button"/>
        <ui:Button name="category-roads" text="Roads" class="category-button"/>
        <ui:Button name="category-commercial" text="Commercial" class="category-button"/>
        <ui:Button name="category-taxiways" text="Taxiways" class="category-button"/>
      </ui:VisualElement>

      <ui:ScrollView
          name="buildable-list"
          mode="Vertical"
          horizontal-page-size="-1"
          class="buildable-list"/>

    </ui:VisualElement>

    <!-- BOTTOM ACTION BAR -->
    <ui:VisualElement name="bottom-bar" picking-mode="Position" class="bottom-bar">

      <ui:Button
          name="build-button"
          text="BUILD"
          class="main-button build-action-button"/>

      <ui:Button
          name="zone-button"
          text="ZONES"
          class="main-button zone-action-button"/>

      <ui:Button
          name="delete-all-button"
          text="DELETE ALL"
          class="main-button delete-all-button"
          tooltip="Enter selection mode to select objects for deletion"/>

    </ui:VisualElement>

    <!-- GAME TIME PANEL -->
    <ui:VisualElement
        name="game-time-panel"
        enabled="true"
        class="game-time-panel">

      <ui:Label
          text="08:00:00"
          name="game-time-label"
          class="game-time-label"/>

      <ui:VisualElement name="game-time-controls" class="game-time-controls">

        <ui:Button
            text="Pause"
            name="time-pause-button"
            class="time-speed-button"/>

        <ui:Button
            text="1X"
            name="time-1x-button"
            class="time-speed-button"/>

        <ui:Button
            text="10X"
            name="time-2x-button"
            class="time-speed-button"/>

        <ui:Button
            text="100X"
            name="time-4x-button"
            class="time-speed-button"/>

        <ui:Button
            text="1000X"
            name="time-8x-button"
            class="time-speed-button"/>

      </ui:VisualElement>
    </ui:VisualElement>

  </ui:VisualElement>
</ui:UXML>
